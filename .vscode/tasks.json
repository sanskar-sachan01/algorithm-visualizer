{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Algorithm Visualizer (macOS)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++20",
                "${workspaceFolder}/Algorithm_visualizer/main.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/bubble_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/selection_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/insertion_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/merge_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/quick_sort.cpp",
                "-I/opt/homebrew/opt/sdl2-compat/include/SDL2",
                "-L/opt/homebrew/opt/sdl2-compat/lib",
                "-lSDL2",
                "-o",
                "${workspaceFolder}/Algorithm_visualizer/Algorithm_visualizer"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "clang++",
            "args": [
                "-std=c++20",
                "${workspaceFolder}/Algorithm_visualizer/main.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/bubble_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/selection_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/insertion_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/merge_sort.cpp",
                "${workspaceFolder}/Algorithm_visualizer/algorithms/quick_sort.cpp",
                "-I/opt/homebrew/opt/sdl2-compat/include/SDL2",
                "-L/opt/homebrew/opt/sdl2-compat/lib",
                "-lSDL2",
                "-o",
                "${workspaceFolder}/Algorithm_visualizer/Algorithm_visualizer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Test Algorithm Visualizer",
            "type": "shell",
            "command": "clang++ -std=c++20 \"${workspaceFolder}/Algorithm_visualizer/tests/algorithm_tests.cpp\" \"${workspaceFolder}/Algorithm_visualizer/algorithms/bubble_sort.cpp\" \"${workspaceFolder}/Algorithm_visualizer/algorithms/selection_sort.cpp\" \"${workspaceFolder}/Algorithm_visualizer/algorithms/insertion_sort.cpp\" \"${workspaceFolder}/Algorithm_visualizer/algorithms/merge_sort.cpp\" \"${workspaceFolder}/Algorithm_visualizer/algorithms/quick_sort.cpp\" -I\"${workspaceFolder}/Algorithm_visualizer\" -o /tmp/algorithm_visualizer_tests && /tmp/algorithm_visualizer_tests",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}